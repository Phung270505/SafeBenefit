# Source-only publication: root entries are excluded unless explicitly allowed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/pyproject.toml
!/run.py
!/src/
!/tests/
!/config/
!/environment/
!/simulator/
!/data/

/src/**
!/src/**/
!/src/**/*.py
/tests/**
!/tests/**/
!/tests/**/*.py
!/tests/cpp/*.cc

/config/*
!/config/study.json
/environment/*
!/environment/requirements.txt
!/environment/software_lock.json

# Metadata only; no raw/processed/fixture/workload data.
/data/*
!/data/manifests/
/data/manifests/*
!/data/manifests/datasets.json

/simulator/**
!/simulator/omnetpp/
!/simulator/omnetpp/**/
!/simulator/omnetpp/**/*.cc
!/simulator/omnetpp/**/*.h
!/simulator/omnetpp/**/*.ned
!/simulator/omnetpp/**/*.ini
!/simulator/omnetpp/**/*.sh
!/simulator/omnetpp/**/README.md

# Never publish generated files, secrets, local tools, or manuscripts.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.env
.env.*
*.pem
*.key
/simulator/**/out/
/simulator/**/Makefile
*.o
*.so
*.dll
*.exe
*.sca
*.vec
*.vci
/docs/
/output/
/.venv/
/.idea/
/.codex/
/.agents/
